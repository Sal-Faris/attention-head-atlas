{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "lab",
  "subagent_depth": 2,
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "skill": "allow",
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git push *": "deny",
      "git reset --hard *": "deny",
      "git clean *": "deny",
      "rm *": "deny",
      "del *": "deny",
      "Remove-Item *": "deny"
    }
  }
}
